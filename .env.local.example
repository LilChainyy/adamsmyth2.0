# =============================================================================
# AdamsMyth 2.0 — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (required — powers the AI chat)
ANTHROPIC_API_KEY=sk-ant-...

# Financial Modeling Prep (required — stock data)
FINANCIAL_DATA_API_KEY=your-fmp-api-key

# OpenAI (required — embeddings for knowledge base RAG)
OPENAI_API_KEY=sk-...

# Firecrawl (optional — enriches news articles with full text)
FIRECRAWL_API_KEY=fc-...
